pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'your-dockerhub-pavankolasani719'
        DOCKERHUB_PASS = 'your-dockerhub-Kolasani.9'
    }

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t backend:latest backend/'
            }
        }

        stage('Push to DockerHub') {
            steps {
                sh 'echo $DOCKERHUB_PASS | docker login -u $DOCKERHUB_USER --password-stdin'
                sh 'docker tag backend:latest $DOCKERHUB_USER/backend:latest'
                sh 'docker push $DOCKERHUB_USER/backend:latest'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f infrastructure/k8s/backend-deploy.yaml'
                sh 'kubectl apply -f infrastructure/k8s/backend-service.yaml'
            }
        }
    }
}
// Jenkinsfile for backend deployment
// This file defines the CI/CD pipeline for the backend service using Jenkins.
stages {
    stage('Build') {
        steps {
            script {
                // Build the Docker image for the backend service
                sh 'docker build -t backend:latest .'
            }
        }
    }

    stage('Test') {
        steps {
            script {
                // Run tests for the backend service
                sh 'docker run --rm backend:latest pytest tests/'
            }
        }
    }

    stage('Deploy') {
        steps {
            script {
                // Deploy the backend service to Kubernetes
                sh 'kubectl apply -f k8s/backend-deployment.yaml'
            }
        }
    }
}